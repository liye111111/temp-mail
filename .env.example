# Copy this file to .env and fill the empty values.
# Never commit real API tokens or application secrets.
# Create a Custom API Token. Permission rows use three separate selectors:
# Account | Workers Scripts | Edit/Write
# Account | D1 | Edit/Write
# Account | Workers R2 Storage | Edit/Write
# Account | Queues | Edit/Write
# Zone | Zone | Read
# Zone | DNS | Edit/Write
# Zone | Email Routing Rules | Edit/Write
# Zone | Zone Settings | Edit/Write
# Zone | Workers Routes | Edit/Write

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
DEPLOY_ENV=production

BRAND_DOMAIN=getopeninbox.com
BRAND_ZONE_ID=
WEB_HOSTNAME=getopeninbox.com
API_HOSTNAME=api.getopeninbox.com
ADMIN_HOSTNAME=admin.getopeninbox.com
STATUS_HOSTNAME=status.getopeninbox.com

WEB_WORKER_NAME=getopeninbox-web
API_WORKER_NAME=getopeninbox-api
EMAIL_WORKER_NAME=getopeninbox-email
QUEUE_WORKER_NAME=getopeninbox-email-consumer

INBOX_DOMAIN=
INBOX_ZONE_ID=
INBOX_DOMAINS=
EMAIL_ROUTING_WORKER_NAME=getopeninbox-email

D1_DATABASE_NAME=getopeninbox-db
D1_DATABASE_ID=
D1_BINDING=DB
D1_PREVIEW_DATABASE_ID=

R2_BUCKET_NAME=getopeninbox-mail
R2_BINDING=MAIL_BUCKET
R2_PREVIEW_BUCKET_NAME=getopeninbox-mail-preview
USE_R2=false
MAX_D1_BODY_BYTES=100000

EMAIL_QUEUE_NAME=getopeninbox-email-parse
EMAIL_QUEUE_BINDING=EMAIL_QUEUE
EMAIL_DEAD_LETTER_QUEUE_NAME=getopeninbox-email-dlq
QUEUE_MAX_BATCH_SIZE=10
QUEUE_MAX_BATCH_TIMEOUT_SECONDS=5
QUEUE_MAX_RETRIES=3

APP_NAME=GetOpenInbox
APP_BASE_URL=https://getopeninbox.com
API_BASE_URL=https://api.getopeninbox.com
DEFAULT_LOCALE=en

INBOX_TTL_SECONDS=600
INBOX_EXTENSION_SECONDS=600
MAX_INBOX_EXTENSIONS=1
MAX_MESSAGES_PER_INBOX=20
MAX_MESSAGE_SIZE_BYTES=2097152
ALLOW_ATTACHMENTS=false
MAX_ACCEPTED_MESSAGES_PER_HOUR=300
INBOX_POLL_INTERVAL_MS=5000
CLEANUP_CRON=*/5 * * * *
# false keeps expired inbox/message rows in D1. R2 lifecycle deletion is unaffected.
DELETE_EXPIRED_D1_DATA=true
EXPIRED_DATA_GRACE_SECONDS=300
MAX_INBOX_CREATES_PER_IP_PER_HOUR=20
MAX_API_REQUESTS_PER_IP_PER_MINUTE=120

SESSION_HMAC_SECRET=
ADDRESS_HASH_SECRET=

# Admin is fail-closed until Access JWT verification is fully configured.
ADMIN_ENABLED=false
ADMIN_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
ADMIN_ACCESS_AUD=
ADMIN_ALLOWED_EMAILS=admin@example.com
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

ENABLE_EMAIL_ROUTING_SETUP=true
ENABLE_DNS_SETUP=true
ENABLE_D1_MIGRATIONS=true
ENABLE_SMOKE_TEST=true
DEPLOY_CONFIRM=false
